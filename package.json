{
  "name": "@chatwoot/viz",
  "version": "0.1.0",
  "description": "Tiny Vue chart components for Chatwoot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatwoot/viz.git"
  },
  "homepage": "https://github.com/chatwoot/viz#readme",
  "bugs": {
    "url": "https://github.com/chatwoot/viz/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "style": "./dist/chatwoot-viz.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/chatwoot-viz.js",
  "module": "./dist/chatwoot-viz.js",
  "exports": {
    ".": "./dist/chatwoot-viz.js",
    "./style.css": "./dist/chatwoot-viz.css"
  },
  "scripts": {
    "analyze": "vite build --mode analyze",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "shiki": "^4.4.3",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=24.4.1"
  },
  "packageManager": "pnpm@10.2.0"
}
